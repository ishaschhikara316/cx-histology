# Heavy data, transient artifacts
data/raw/
data/interim/
data/labels/*
!data/labels/.gitkeep
results/
*.svs
*.tiff
*.h5
*.pt
*.ckpt
*.npy
*.npz

# Allow small results back: cv summaries, robustness, predictions, atlases.
# These are JSON or TSV at <1 MB each and they are the actual headline outputs.
!results/cv/**/cv_summary.json
!results/cv/**/robustness.json
!results/cv/**/patient_bootstrap.json
!results/cv/**/rho_per_cohort.tsv
!results/cv/**/predictions.tsv
!results/cx_label_atlas.json
!results/

# CPTAC external validation: predictions, recomputed labels, H2 summary.
# Upstream GDC seg files at data/labels/cptac_pdc/ are intentionally not
# committed (16 MB, regenerable via workflow/scripts/fetch_cptac_gdc_seg.py).
!results/external/**/*.tsv
!results/external/**/*.json
!data/labels/cx_activities_cptac.tsv

# Tokens and secrets
.gdc_token
.hf_token

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Snakemake
.snakemake/
logs/

# Editor / OS
.vscode/
.idea/
.DS_Store
